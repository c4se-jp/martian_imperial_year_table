{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [":configMigration", "config:recommended"],
  ignorePaths: ["martian_imperial_year_table_py/**"],
  labels: ["dependencies"],
  minimumReleaseAge: "5 days",
  packageRules: [
    {
      // patch ver.の通常updateはpull requestを作らない。security updateはvulnerabilityAlertsが別途pull requestを作る。
      enabled: false,
      matchUpdateTypes: ["patch"],
    },
    {
      automerge: true,
      automergeType: "pr",
      labels: ["dependencies", "minor"],
      matchUpdateTypes: ["minor"],
    },
    {
      automerge: false,
      labels: ["dependencies", "major"],
      matchUpdateTypes: ["major"],
    },
    {
      // ai-reviewがOPENAI_API_KEYをこのactionに渡すため、レビュー前の未檢證なコードに祕密が渡らないやう自動mergeの對象から外す。
      // labelsは指定しない: labelsは非mergeableで後勝ちのため、ここで指定すると
      // 前段のminor/majorルールが付けた更新種別ラベルを消してしまふ。
      automerge: false,
      matchDepNames: ["openai/codex-action"],
      matchManagers: ["github-actions"],
    },
  ],
  schedule: "after 10am and before 7pm every weekday",
  timezone: "Asia/Tokyo",
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
  },
}
