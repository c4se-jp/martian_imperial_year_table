{
  "name": "martian_ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate:docs && npm run build:web",
    "build:web": "vite build --outDir ../../dist --emptyOutDir true",
    "generate:api-doc": "node ./scripts/generate-api-doc.mjs",
    "generate:docs": "npm run generate:api-doc && npm run generate:mcp-doc && npm run generate:graphql-doc",
    "generate:graphql-doc": "node ./scripts/generate-graphql-doc.mjs",
    "generate:mcp-doc": "node ./scripts/generate-mcp-doc.mjs",
    "lint": "echo \"No linting configured\"",
    "preview": "vite preview",
    "start:dev": "npm run generate:docs && vite",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-web": "^0.68.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-web": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bulma": "^1.0.4",
    "marked": "^18.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "graphql": "^17.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  }
}
